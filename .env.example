# Solana Social Discovery Engine — credentials (this file never leaves your machine)
# Fill in the ones you have; the engine refuses to go live without HELIUS + X.

# REQUIRED — Helius API key (https://dashboard.helius.dev → free tier works to start)
HELIUS_API_KEY=

# REQUIRED — X/Twitter API v2 bearer token (https://developer.x.com → app → Keys and Tokens)
X_BEARER_TOKEN=

# OPTIONAL — public Telegram channel reading via Telethon
# (https://my.telegram.org/apps → api_id / api_hash; session string from a one-time login)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# OPTIONAL overrides
# SSE_PORT=7100
# SSE_HF_INTERVAL=7
